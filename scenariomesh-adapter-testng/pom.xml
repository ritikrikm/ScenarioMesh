<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.scenariomesh</groupId><artifactId>scenariomesh-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>scenariomesh-adapter-testng</artifactId>
  <dependencies>
    <dependency><groupId>io.scenariomesh</groupId><artifactId>scenariomesh-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.scenariomesh</groupId><artifactId>scenariomesh-maven-selection</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.testng</groupId><artifactId>testng</artifactId><version>${testng.version}</version></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- These are adapter input fixtures, not tests of this module themselves. -->
          <excludes>
            <exclude>**/*Fixture.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
