<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example</groupId>
  <artifactId>maven-equivalence-example</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.5</junit.version>
    <surefire.version>3.5.2</surefire.version>
    <contract.value>pom-default</contract.value>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <includes>
            <include>**/ShouldNotRunTest.java</include>
          </includes>
          <systemPropertyVariables>
            <contract.pom>${contract.value}</contract.pom>
            <contract.trace>${project.basedir}/target/maven-equivalence-events.log</contract.trace>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>selection-files</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes combine.self="override">
                <include>**/AlphaContractTest.java</include>
              </includes>
              <includesFile>${project.basedir}/selectors/includes.txt</includesFile>
              <excludesFile>selectors/excludes.txt</excludesFile>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>fork-context</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <enableAssertions>false</enableAssertions>
              <workingDirectory>${project.build.directory}</workingDirectory>
              <environmentVariables>
                <CONTRACT_CONFIGURED>configured-value</CONTRACT_CONFIGURED>
                <CONTRACT_OVERLAY>configured-overlay</CONTRACT_OVERLAY>
                <CONTRACT_EMPTY></CONTRACT_EMPTY>
              </environmentVariables>
              <excludedEnvironmentVariables>
                <excludedEnvironmentVariable>CONTRACT_EXCLUDED</excludedEnvironmentVariable>
                <excludedEnvironmentVariable>CONTRACT_OVERLAY</excludedEnvironmentVariable>
              </excludedEnvironmentVariables>
              <systemPropertyVariables>
                <contract.precedence>executor-value</contract.precedence>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
